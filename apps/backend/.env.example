DJANGO_SECRET_KEY=change-me
DEBUG=true
DATABASE_URL=postgres://postgres:postgres@db:5432/fitness
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

SENTRY_DSN=

GOOGLE_OAUTH_CLIENT_IDS=

# === Email / verification ===
# Leave EMAIL_BACKEND commented out to print verification emails to the
# runserver console (no real send). Uncomment it to send via Gmail SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
USE_CLOUDFLARE_CLIENT_IP=
PUBLIC_BASE_URL=