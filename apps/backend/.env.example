DJANGO_SECRET_KEY=change-me
DEBUG=true
DATABASE_URL=postgres://postgres:postgres@db:5432/fitness
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

SENTRY_DSN=

GOOGLE_OAUTH_CLIENT_IDS=

# === FatSecret restaurant-nutrition proxy (KAN-67) ===
# Credentials from platform.fatsecret.com -> Generate/View API Keys. Leave
# empty to disable: the proxy answers 503 and the app quietly stays OFF-only.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# Blank omits the region param — required for keys without FatSecret's paid
# localization entitlement. Set GB only once the account has been granted it
# (an entitlement-less key sending a region may be rejected upstream).
FATSECRET_REGION=
# oauth1 (the default) signs every request and needs NO IP whitelisting.
# oauth2 uses the token endpoint, which rejects non-whitelisted egress IPs —
# unusable behind shared egress (Render) without a paid dedicated IP.
# FATSECRET_AUTH=oauth1
# Token scope, oauth2 mode only. "premier" matches the Premier Free tier.
# FATSECRET_SCOPE=premier

# === Email / verification ===
# Leave EMAIL_BACKEND commented out to print verification emails to the
# runserver console (no real send). Uncomment it to send via Gmail SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
USE_CLOUDFLARE_CLIENT_IP=
PUBLIC_BASE_URL=

# === Android Digital Asset Links ===
# Lets Google Password Manager share a saved login between the website and the
# app (served at /.well-known/assetlinks.json). ANDROID_CERT_FINGERPRINTS is a
# comma-separated list of public SHA-256 signing-cert fingerprints (debug,
# release upload key, and Play App Signing). Leave empty to disable.
ANDROID_APP_PACKAGE=uk.drakon4ik.symbio
ANDROID_CERT_FINGERPRINTS=